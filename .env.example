PORT=5000
JWT_SECRET=change_me_in_production

# EmailJS (https://www.emailjs.com) — delivers voter one-time sign-in codes.
# Without these set, OTPs are just printed to the backend console instead
# of emailed (fine for local dev/testing).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Only needed if your EmailJS account has "Strict Mode" enabled.
EMAILJS_PRIVATE_KEY=
EMAILJS_FROM_NAME=East Godavari Election Commission
