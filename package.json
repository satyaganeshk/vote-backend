{
  "name": "vote-backend",
  "version": "1.0.0",
  "description": "Secure Single-Vote RBAC Democratic Voting Backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--use-system-ca node dist/index.js",
    "dev": "cross-env NODE_OPTIONS=--use-system-ca tsx watch src/index.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
