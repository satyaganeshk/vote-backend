# Demo/test credentials — NOT consumed by the app at runtime.
#
# The backend never reads these as env vars; login is done through the UI/API
# with real request bodies (email+password for Admin/Candidate, or Voter ID +
# emailed one-time code for Voters). This file just collects the plaintext
# admin/candidate passwords that vote-backend/src/db.ts hashes with bcrypt and
# seeds into voting.db on first run, so you have them in one place for manual
# testing. Password hashes can't be reversed from the DB — this list only
# works because the plaintext values are hardcoded in the seed script.
#
# Seeded voters have no password/PIN at all — they sign in via OTP, but their
# seeded emails below are placeholder addresses, not real inboxes, so you
# won't receive their codes. Register a voter with a real email through the
# Admin dashboard's "Add voter" to actually test the OTP flow.
#
# Regenerate this data any time by deleting voting.db(-wal/-shm) at the repo
# root and restarting `npm run dev` in vote-backend — initDatabase() reseeds
# it automatically when the users table is empty.

# ---- Admin (email + password login) ----
ADMIN_EMAIL=admin@elections.ap.gov.in
ADMIN_PASSWORD=admin@123

# ---- Candidates (email + password login) ----
# All candidate accounts share the same seeded password.
CANDIDATE_PASSWORD=candidate@123

CANDIDATE_1_EMAIL=kondababu.tdp@gmail.com          # Vanamadi Venkateswara Rao (Konda Babu) — TDP, Kakinada City — APPROVED
CANDIDATE_2_EMAIL=chandrasekhar.ysrcp@gmail.com     # Dwarampudi Chandrasekhar Reddy — YSRCP, Kakinada City — APPROVED
CANDIDATE_3_EMAIL=nanaji.jsp@gmail.com              # Pantham Nanaji — JSP, Kakinada Rural — APPROVED

# ---- Voters (Voter ID + emailed one-time code login; no PIN) ----
